		{
			"name": "Create comment",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function() {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"pm.test(\"Response has correct structure\", function() {\r",
							"    const response = pm.response.json();\r",
							"    pm.expect(response).to.have.property('id');\r",
							"    pm.expect(response).to.have.property('text', 'This is a test comment');\r",
							"    pm.expect(response).to.have.property('state', 'PENDING');\r",
							"    pm.expect(response).to.have.property('eventId', pm.collectionVariables.get(\"event_id\"));\r",
							"    pm.expect(response.author).to.have.property('id', pm.collectionVariables.get(\"user_id\"));\r",
							"});\r",
							"\r",
							"const response = pm.response.json();\r",
							"pm.collectionVariables.set(\"comment_id\", response.id);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const createUser = {\r",
							"    url: pm.collectionVariables.get(\"base_url\") + \"/admin/users\",\r",
							"    method: 'POST',\r",
							"    header: 'Content-Type: application/json',\r",
							"    body: {\r",
							"        mode: 'raw',\r",
							"        raw: JSON.stringify({\r",
							"            \"name\": \"Test User\",\r",
							"            \"email\": \"testuser_\" + Math.floor(Math.random() * 10000) + \"@example.com\"\r",
							"        })\r",
							"    }\r",
							"};\r",
							"\r",
							"pm.sendRequest(createUser, (err, res) => {\r",
							"    if (err) {\r",
							"        console.error(\"Error creating user:\", err);\r",
							"        return;\r",
							"    }\r",
							"    \r",
							"    pm.collectionVariables.set(\"user_id\", res.json().id);\r",
							"    console.log(\"Created user with ID:\", pm.collectionVariables.get(\"user_id\"));\r",
							"\r",
							"    const createCategory = {\r",
							"        url: pm.collectionVariables.get(\"base_url\") + \"/admin/categories\",\r",
							"        method: 'POST',\r",
							"        header: 'Content-Type: application/json',\r",
							"        body: {\r",
							"            mode: 'raw',\r",
							"            raw: JSON.stringify({\r",
							"                \"name\": \"Test Category \" + Math.floor(Math.random() * 1000)\r",
							"            })\r",
							"        }\r",
							"    };\r",
							"\r",
							"    pm.sendRequest(createCategory, (err, res) => {\r",
							"        if (err) {\r",
							"            console.error(\"Error creating category:\", err);\r",
							"            return;\r",
							"        }\r",
							"        \r",
							"        pm.collectionVariables.set(\"category_id\", res.json().id);\r",
							"        console.log(\"Created category with ID:\", pm.collectionVariables.get(\"category_id\"));\r",
							"\r",
							"        const createEvent = {\r",
							"            url: pm.collectionVariables.get(\"base_url\") + \"/users/\" + pm.collectionVariables.get(\"user_id\") + \"/events\",\r",
							"            method: 'POST',\r",
							"            header: 'Content-Type: application/json',\r",
							"            body: {\r",
							"                mode: 'raw',\r",
							"                raw: JSON.stringify({\r",
							"                    \"annotation\": \"Test event annotation\",\r",
							"                    \"category\": pm.collectionVariables.get(\"category_id\"),\r",
							"                    \"description\": \"Detailed description of test event\",\r",
							"                    \"eventDate\": \"2025-12-31 15:10:05\",\r",
							"                    \"location\": {\r",
							"                        \"lat\": 55.754167,\r",
							"                        \"lon\": 37.62\r",
							"                    },\r",
							"                    \"paid\": true,\r",
							"                    \"title\": \"Test Event\",\r",
							"                    \"participantLimit\": 10\r",
							"                })\r",
							"            }\r",
							"        };\r",
							"\r",
							"        pm.sendRequest(createEvent, (err, res) => {\r",
							"            if (err) {\r",
							"                console.error(\"Error creating event:\", err);\r",
							"                return;\r",
							"            }\r",
							"            \r",
							"            pm.collectionVariables.set(\"event_id\", res.json().id);\r",
							"            console.log(\"Created event with ID:\", pm.collectionVariables.get(\"event_id\"));\r",
							"        });\r",
							"    });\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
